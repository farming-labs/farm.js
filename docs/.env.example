DATABASE_URL="postgresql://user:password@localhost:5432/farmjs"
# Optional dedicated signup database. Falls back to DATABASE_URL when empty.
WAITLIST_DATABASE_URL=""
FARM_TELEMETRY_IDENTITY_SALT="replace-with-a-long-random-server-only-value"
FARM_TELEMETRY_DASHBOARD_TOKEN="replace-with-a-long-random-dashboard-token"
FARM_TELEMETRY_RETENTION_DAYS="90"
# Agent-ready check (/agents/check). Scans run on Farm.js Infrastructure
# (https://app.farmjs.dev unless FARMJS_API_URL says otherwise) and need no account.
# The optional API key, from Settings > API keys, rate-limits each visitor separately
# instead of every visitor sharing this server's budget.
FARMJS_API_URL=""
FARMJS_API_KEY=""
