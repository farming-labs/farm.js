{
  "name": "farmjs-docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @farm.js/core build && pnpm --filter @farm.js/cli build && pnpm run prisma:generate && farm dev",
    "build": "pnpm --filter @farm.js/core build:runtime && pnpm --filter @farm.js/cli build && pnpm run prisma:generate && NODE_OPTIONS=--max-old-space-size=6144 farm build",
    "preview": "farm preview",
    "prisma:generate": "DATABASE_URL=${DATABASE_URL:-postgresql://user:password@localhost:5432/farmjs} prisma generate",
    "db:push": "prisma db push"
  },
  "dependencies": {
    "@databuddy/sdk": "2.6.0",
    "@farm.js/core": "workspace:*",
    "@farming-labs/docs": "0.2.108",
    "@farming-labs/farmjs": "0.2.108",
    "@farming-labs/theme": "0.2.99",
    "@prisma/client": "6.7.0",
    "better-call": "^1.0.19",
    "lucide-react": "1.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "simple-icons": "16.25.0",
    "sugar-high": "0.9.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@farm.js/cli": "workspace:*",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "autoprefixer": "^10.4.16",
    "geist": "1.7.0",
    "postcss": "^8.4.32",
    "prisma": "6.7.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.5.3",
    "vite": "^5.0.10"
  }
}
