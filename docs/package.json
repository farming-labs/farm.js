{
  "name": "farmjs-docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @farmjs/core build && pnpm run prisma:generate && farm dev",
    "build": "pnpm --filter @farmjs/core build && pnpm run prisma:generate && farm build",
    "preview": "farm preview",
    "prisma:generate": "DATABASE_URL=${DATABASE_URL:-postgresql://user:password@localhost:5432/farmjs} prisma generate",
    "db:push": "prisma db push"
  },
  "dependencies": {
    "@farming-labs/docs": "^0.2.44",
    "@farmjs/core": "workspace:*",
    "@prisma/client": "6.7.0",
    "better-call": "^1.0.19",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@farmjs/cli": "workspace:*",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "autoprefixer": "^10.4.16",
    "geist": "1.7.0",
    "postcss": "^8.4.32",
    "prisma": "6.7.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.5.3",
    "vite": "^5.0.10"
  }
}
