{
  "name": "@farm.js/devtools",
  "version": "0.1.27",
  "description": "Development workspace inspector for Farm.js routes, runtime, and browser modules",
  "keywords": [
    "devtools",
    "farm.js",
    "inspect",
    "vite"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/farming-labs/farm.js",
    "directory": "packages/farm-devtools"
  },
  "files": [
    "THIRD-PARTY-NOTICES.md",
    "dist/index.*",
    "dist/client.*",
    "dist/server.*",
    "dist/modules.*",
    "dist/types.*",
    "dist/ui"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc && node scripts/build-ui.mjs",
    "build:runtime": "node scripts/build-runtime.mjs && node scripts/build-ui.mjs",
    "type-check": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/geist-mono": "5.3.0"
  },
  "devDependencies": {
    "@farm.js/core": "workspace:*",
    "@fontsource-variable/geist": "5.3.0",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.0",
    "jsdom": "^25.0.0",
    "sugar-high": "0.9.5",
    "typescript": "^5.3.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "peerDependencies": {
    "@farm.js/core": ">=0.1.28 <0.2.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
