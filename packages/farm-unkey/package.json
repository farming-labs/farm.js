{
  "name": "@farm.js/unkey",
  "version": "0.2.0-beta.0",
  "description": "Unkey integration for Farm.js",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/farming-labs/farm.js",
    "directory": "packages/farm-unkey"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc",
    "dev": "tsc --watch",
    "type-check": "tsc --noEmit",
    "test": "echo 'No tests in this package'"
  },
  "dependencies": {
    "@farm.js/integration-utils": "workspace:*"
  },
  "devDependencies": {
    "@farm.js/core": "workspace:*"
  },
  "peerDependencies": {
    "@farm.js/core": ">=0.1.78 <0.4.0 || >=0.2.0-beta.0 <0.2.0"
  }
}
