{
  "name": "@farm.js/stylex",
  "version": "0.1.0-beta.0",
  "description": "Zero-config StyleX compilation and HMR for Farm.js applications",
  "keywords": [
    "css-in-js",
    "farm.js",
    "stylex",
    "vite"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/farming-labs/farm.js",
    "directory": "packages/farm-stylex"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc",
    "dev": "tsc --watch",
    "type-check": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@farm.js/core": "workspace:*",
    "@stylexjs/unplugin": "^0.19.0",
    "unplugin": "^2.3.11"
  },
  "devDependencies": {
    "@stylexjs/stylex": "^0.19.0",
    "@types/node": "^20.10.5",
    "typescript": "^5.3.3",
    "vite": "^5.0.10",
    "vitest": "^3.2.7"
  },
  "peerDependencies": {
    "@stylexjs/stylex": "^0.19.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
