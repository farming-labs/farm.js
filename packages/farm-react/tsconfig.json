{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "declaration": true,
    "declarationMap": true,
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@farm.js/core/renderer": ["../farm/src/renderer.ts"],
      "@farm.js/core/renderer/react/client": ["../farm/src/renderer/react/client.ts"],
      "@farm.js/core/renderer/react/server": ["../farm/src/renderer/react/server.ts"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["dist", "node_modules", "**/*.test.*"]
}
