{
  "name": "@farm.js/plugin",
  "version": "0.1.0-beta.4",
  "description": "Official plugins for Farm.js framework",
  "license": "MIT",
  "author": "Farm.js Team",
  "repository": {
    "type": "git",
    "url": "https://github.com/farming-labs/farm.js",
    "directory": "packages/farmjs-plugin"
  },
  "files": [
    "dist",
    "scripts"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./rsc": {
      "types": "./dist/rsc/index.d.ts",
      "import": "./dist/rsc/index.js"
    },
    "./rsc/optimized-boundary": {
      "types": "./dist/rsc/optimized-boundary.d.ts",
      "import": "./dist/rsc/optimized-boundary.js"
    },
    "./rsc/vite-plugin-nitro": {
      "types": "./dist/rsc/vite-plugin-nitro.d.ts",
      "import": "./dist/rsc/vite-plugin-nitro.js"
    },
    "./middleware": {
      "types": "./dist/middleware/index.d.ts",
      "import": "./dist/middleware/index.js"
    },
    "./api": {
      "types": "./dist/api/index.d.ts",
      "import": "./dist/api/index.js"
    },
    "./observability": {
      "types": "./dist/observability/index.d.ts",
      "import": "./dist/observability/index.js"
    },
    "./context": {
      "types": "./dist/context/index.d.ts",
      "import": "./dist/context/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/clean.js && tsc && node scripts/build.js",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@farm.js/core": "workspace:*",
    "@farming-labs/strata": "0.1.2",
    "better-call": "^1.0.19",
    "es-module-lexer": "2.0.0",
    "nitro": "3.0.1-alpha.0",
    "picocolors": "^1.0.0",
    "rsc-html-stream": "^0.0.4"
  },
  "devDependencies": {
    "@types/node": "^20.19.21",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-rsc": "0.5.32",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-server-dom-webpack": "19.2.8",
    "tsdown": "^0.15.7",
    "typescript": "^5.5.3",
    "vite": "^6.0.0",
    "vitest": "^1.1.0"
  },
  "peerDependencies": {
    "@farm.js/core": "workspace:*",
    "@vitejs/plugin-rsc": "0.5.32",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-server-dom-webpack": "19.2.8",
    "vite": ">=6.0.0"
  },
  "peerDependenciesMeta": {
    "@vitejs/plugin-rsc": {
      "optional": true
    },
    "react-server-dom-webpack": {
      "optional": true
    }
  }
}
