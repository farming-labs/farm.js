{
  "name": "@farmjs/plugin",
  "version": "0.0.1",
  "description": "Official plugins for Farm.js framework",
  "license": "MIT",
  "author": "Farm.js Team",
  "files": [
    "dist",
    "scripts"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./rsc": {
      "types": "./dist/rsc/index.d.ts",
      "import": "./dist/rsc/index.js"
    },
    "./rsc/vite-plugin-nitro": {
      "types": "./dist/rsc/vite-plugin-nitro.d.ts",
      "import": "./dist/rsc/vite-plugin-nitro.js"
    },
    "./middleware": {
      "types": "./dist/middleware/index.d.ts",
      "import": "./dist/middleware/index.js"
    },
    "./api": {
      "types": "./dist/api/index.d.ts",
      "import": "./dist/api/index.js"
    }
  },
  "scripts": {
    "build": "tsc && node scripts/build.js",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "echo 'No tests in this package'"
  },
  "dependencies": {
    "@farmjs/core": "workspace:*",
    "better-call": "^1.0.19",
    "nitro": "3.0.1-alpha.0",
    "picocolors": "^1.0.0",
    "rsc-html-stream": "^0.0.4"
  },
  "devDependencies": {
    "@types/node": "^20.19.21",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-rsc": "^0.5.18",
    "tsdown": "^0.15.7",
    "typescript": "^5.5.3",
    "vite": "^6.0.0"
  },
  "peerDependencies": {
    "@farmjs/core": "workspace:*",
    "@vitejs/plugin-rsc": ">=0.5.0",
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0",
    "vite": ">=6.0.0"
  },
  "peerDependenciesMeta": {
    "@vitejs/plugin-rsc": {
      "optional": true
    }
  }
}
