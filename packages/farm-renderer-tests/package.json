{
  "name": "@farm.js/renderer-tests",
  "version": "0.1.0-beta.2",
  "description": "Conformance tests for Farm.js renderers",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/farming-labs/farm.js",
    "directory": "packages/farm-renderer-tests"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "peerDependencies": {
    "vitest": "^5.0.0"
  }
}
