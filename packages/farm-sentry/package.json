{
  "name": "@farm.js/sentry",
  "version": "0.1.0-beta.78",
  "description": "Sentry error reporting and tracing for Farm.js",
  "keywords": [
    "error-tracking",
    "farm.js",
    "monitoring",
    "observability",
    "sentry",
    "tracing"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/farming-labs/farm.js",
    "directory": "packages/farm-sentry"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc",
    "dev": "tsc --watch",
    "type-check": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@farm.js/core": "workspace:*"
  },
  "devDependencies": {
    "@sentry/node": "^10.71.0",
    "typescript": "^5.3.3",
    "vitest": "^3.2.7"
  },
  "peerDependencies": {
    "@sentry/node": ">=8.47.0"
  },
  "peerDependenciesMeta": {
    "@sentry/node": {
      "optional": true
    }
  }
}
