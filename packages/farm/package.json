{
  "name": "@farmjs/core",
  "version": "0.0.3-beta.3",
  "description": "Core Farm.js framework - A modern React meta-framework",
  "keywords": [
    "@farmjs/core",
    "framework",
    "react",
    "rsc",
    "server-components",
    "ssr",
    "vite"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/farm-js/farm.js",
    "directory": "packages/farm"
  },
  "files": [
    "dist",
    "types"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "middleware": [
        "./types/middleware.d.ts",
        "./dist/middleware.d.ts"
      ],
      "storage": [
        "./dist/storage.d.ts"
      ],
      "api": [
        "./types/api.d.ts",
        "./dist/api.d.ts"
      ],
      "client": [
        "./types/client.d.ts",
        "./dist/client.d.ts"
      ],
      "server": [
        "./dist/server.d.ts"
      ],
      "vite": [
        "./dist/vite.d.ts"
      ],
      "plugin": [
        "./dist/plugin.d.ts"
      ],
      "query": [
        "./dist/query/index.d.ts"
      ],
      "*": [
        "./dist/*.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.mjs"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.mjs",
      "require": "./dist/server.cjs"
    },
    "./client": {
      "types": "./types/client.d.ts",
      "import": "./dist/client.mjs",
      "require": "./dist/client.cjs"
    },
    "./storage": {
      "types": "./dist/storage.d.ts",
      "import": "./dist/storage.mjs",
      "require": "./dist/storage.cjs"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.mjs",
      "require": "./dist/vite.cjs"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.mjs",
      "require": "./dist/plugin.cjs"
    },
    "./plugin/server": {
      "types": "./dist/server-plugins.d.ts",
      "import": "./dist/server-plugins.mjs",
      "require": "./dist/server-plugins.cjs"
    },
    "./plugin/client": {
      "types": "./dist/client-plugins.d.ts",
      "import": "./dist/client-plugins.mjs",
      "require": "./dist/client-plugins.cjs"
    },
    "./query": {
      "types": "./dist/query/index.d.ts",
      "import": "./dist/query/index.mjs",
      "require": "./dist/query/index.cjs"
    },
    "./query/parsers": {
      "types": "./dist/query/parsers.d.ts",
      "import": "./dist/query/parsers.mjs",
      "require": "./dist/query/parsers.cjs"
    },
    "./query/client": {
      "types": "./dist/query/client.d.ts",
      "import": "./dist/query/client.mjs",
      "require": "./dist/query/client.cjs"
    },
    "./query/server": {
      "types": "./dist/query/server.d.ts",
      "import": "./dist/query/server.mjs",
      "require": "./dist/query/server.cjs"
    },
    "./middleware": {
      "types": "./dist/middleware.d.ts",
      "import": "./dist/middleware.mjs",
      "require": "./dist/middleware.cjs"
    },
    "./api": {
      "types": "./dist/api.d.ts",
      "import": "./dist/api.mjs",
      "require": "./dist/api.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:coverage": "vitest --coverage",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@scalar/api-reference": "^1.38.1",
    "@scalar/openapi-parser": "^0.22.3",
    "@tailwindcss/vite": "^4.1.0",
    "@vitejs/plugin-react": "^4.2.1",
    "better-call": "^1.0.19",
    "db0": "^0.3.4",
    "esbuild": "^0.19.11",
    "fast-glob": "^3.3.2",
    "h3": "2.0.1-rc.5",
    "nitro": "3.0.1-alpha.0",
    "pg": "^8.20.0",
    "picocolors": "^1.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-server-dom-webpack": "^18.3.0-canary-670c8dfb8-20231204",
    "sirv": "^2.0.4",
    "supports-color": "^10.2.2",
    "tailwindcss": "^4.0.0",
    "unstorage": "^2.0.0-alpha.3",
    "vite": "^5.0.10",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@clerk/react": "^6.1.0",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "@vitest/coverage-v8": "^1.1.0",
    "jsdom": "^25.0.0",
    "tsup": "^8.3.5",
    "typescript": "^5.3.3",
    "vitest": "^1.1.0"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  }
}
