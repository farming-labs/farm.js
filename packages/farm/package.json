{
  "name": "farm",
  "version": "0.0.1",
  "description": "Core Farm.js framework - A modern React meta-framework built on Vite",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.mjs",
      "require": "./dist/server.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.mjs",
      "require": "./dist/client.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.mjs",
      "require": "./dist/vite.js"
    },
    "./plugin/server": {
      "types": "./dist/server-plugins.d.ts",
      "import": "./dist/server-plugins.mjs",
      "require": "./dist/server-plugins.js"
    },
    "./plugin/client": {
      "types": "./dist/client-plugins.d.ts",
      "import": "./dist/client-plugins.mjs",
      "require": "./dist/client-plugins.js"
    }
  },
  "files": [
    "dist",
    "client.js",
    "server.js",
    "vite.js"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "better-call": "^1.0.19",
    "esbuild": "^0.19.11",
    "fast-glob": "^3.3.2",
    "picocolors": "^1.0.0",
    "postcss": "^8.4.32",
    "react": "19.0.0-rc.1",
    "react-dom": "19.0.0-rc.1",
    "react-server-dom-webpack": "^18.3.0-canary-670c8dfb8-20231204",
    "sirv": "^2.0.4",
    "tailwindcss": "^3.4.0",
    "vite": "^5.0.10",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "@vitest/coverage-v8": "^1.1.0",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3",
    "vitest": "^1.1.0"
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "keywords": [
    "react",
    "vite",
    "framework",
    "rsc",
    "server-components",
    "ssr",
    "farm"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/farm-js/farm.js",
    "directory": "packages/farm"
  },
  "license": "MIT"
}
