{
  "name": "@farmjs/core",
  "version": "0.0.3-beta.3",
  "description": "Core Farm.js framework - A modern React meta-framework",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./server": {
      "types": "./dist/server.d.mts",
      "import": "./dist/server.mjs",
      "require": "./dist/server.cjs"
    },
    "./client": {
      "types": "./dist/client.d.mts",
      "import": "./dist/client.mjs",
      "require": "./dist/client.cjs"
    },
    "./vite": {
      "types": "./dist/vite.d.mts",
      "import": "./dist/vite.mjs",
      "require": "./dist/vite.cjs"
    },
    "./plugin": {
      "types": "./dist/plugin.d.mts",
      "import": "./dist/plugin.mjs",
      "require": "./dist/plugin.cjs"
    },
    "./plugin/server": {
      "types": "./dist/server-plugins.d.mts",
      "import": "./dist/server-plugins.mjs",
      "require": "./dist/server-plugins.cjs"
    },
    "./plugin/client": {
      "types": "./dist/client-plugins.d.mts",
      "import": "./dist/client-plugins.mjs",
      "require": "./dist/client-plugins.cjs"
    },
    "./query": {
      "types": "./dist/query/index.d.mts",
      "import": "./dist/query/index.mjs",
      "require": "./dist/query/index.cjs"
    },
    "./query/parsers": {
      "types": "./dist/query/parsers.d.mts",
      "import": "./dist/query/parsers.mjs",
      "require": "./dist/query/parsers.cjs"
    },
    "./query/client": {
      "types": "./dist/query/client.d.mts",
      "import": "./dist/query/client.mjs",
      "require": "./dist/query/client.cjs"
    },
    "./query/server": {
      "types": "./dist/query/server.d.mts",
      "import": "./dist/query/server.mjs",
      "require": "./dist/query/server.cjs"
    },
    "./middleware": {
      "types": "./dist/middleware.d.mts",
      "import": "./dist/middleware.mjs",
      "require": "./dist/middleware.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown && node scripts/post-build.js",
    "dev": "tsdown --watch",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@scalar/api-reference": "^1.38.1",
    "@scalar/openapi-parser": "^0.22.3",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "better-call": "^1.0.19",
    "esbuild": "^0.19.11",
    "fast-glob": "^3.3.2",
    "h3": "2.0.1-rc.5",
    "nitro": "3.0.1-alpha.0",
    "picocolors": "^1.0.0",
    "postcss": "^8.4.32",
    "react": "19.0.0-rc.1",
    "react-dom": "19.0.0-rc.1",
    "react-server-dom-webpack": "^18.3.0-canary-670c8dfb8-20231204",
    "sirv": "^2.0.4",
    "tailwindcss": "^3.4.0",
    "vite": "^5.0.10",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "@vitest/coverage-v8": "^1.1.0",
    "tsdown": "^0.15.7",
    "typescript": "^5.3.3",
    "vitest": "^1.1.0"
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "keywords": [
    "react",
    "vite",
    "framework",
    "rsc",
    "server-components",
    "ssr",
    "@farmjs/core"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/farm-js/farm.js",
    "directory": "packages/farm"
  },
  "license": "MIT"
}
