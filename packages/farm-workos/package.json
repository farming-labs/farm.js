{
  "name": "@farm.js/workos",
  "version": "0.1.0-beta.8",
  "description": "WorkOS integration for Farm.js",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/farming-labs/farm.js",
    "directory": "packages/farm-workos"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc",
    "dev": "tsc --watch",
    "type-check": "tsc --noEmit",
    "test": "echo 'No tests in this package'"
  },
  "dependencies": {
    "@farm.js/core": "workspace:*",
    "@farm.js/integration-utils": "workspace:*",
    "@workos-inc/node": "^8.9.0"
  }
}
