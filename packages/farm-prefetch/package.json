{
  "name": "@farm.js/prefetch",
  "version": "0.1.0-beta.1",
  "description": "App-wide link prefetching for Farm.js: hover and viewport prefetching for plain anchors, as the default policy layer beside core Link",
  "keywords": [
    "farm.js",
    "navigation",
    "performance",
    "prefetch"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/farming-labs/farm.js",
    "directory": "packages/farm-prefetch"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@farm.js/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "jsdom": "^25.0.0",
    "typescript": "^5.3.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
