{
  "name": "@farm.js/hints",
  "version": "0.1.0-beta.0",
  "description": "Development accessibility, performance, HTML, and third-party hints for Farm.js",
  "keywords": [
    "accessibility",
    "developer-tools",
    "farm.js",
    "performance",
    "web-vitals"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/farming-labs/farm.js",
    "directory": "packages/farm-hints"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc",
    "dev": "tsc --watch",
    "type-check": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@farm.js/core": "workspace:*",
    "@fontsource-variable/geist-mono": "5.3.0",
    "axe-core": "^4.13.0",
    "web-vitals": "^6.2.1"
  },
  "devDependencies": {
    "@types/node": "^20.10.5",
    "jsdom": "^25.0.0",
    "typescript": "^5.3.3",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
