{
  "$schema": "https://docs.farming-labs.dev/schema/docs.json",
  "version": 1,
  "entry": "docs",
  "docsPath": "/docs",
  "docs": {
    "mode": "framework",
    "runtime": "farm",
    "root": "."
  },
  "content": {
    "docsRoot": "src/app/docs"
  },
  "site": {
    "name": "Farm App Docs"
  },
  "nav": {
    "title": "Farm App"
  },
  "search": {
    "provider": "simple",
    "enabled": true,
    "maxResults": 12
  },
  "llmsTxt": {
    "enabled": true,
    "siteTitle": "Farm App Docs",
    "siteDescription": "Documentation for your Farm.js app."
  },
  "sitemap": true,
  "robots": true
}
