{
  "name": "farm-cli",
  "version": "0.0.1",
  "description": "CLI for Farm.js framework",
  "main": "./dist/index.js",
  "bin": {
    "farm": "./bin/farm.js"
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "farm": "workspace:*",
    "commander": "^11.1.0",
    "picocolors": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.5",
    "tsdown": "^0.15.7",
    "typescript": "^5.3.3"
  },
  "keywords": [
    "farm",
    "cli",
    "react",
    "vite"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/farm-js/farm.js",
    "directory": "packages/farm-cli"
  },
  "license": "MIT"
}
