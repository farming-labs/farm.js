{
  "name": "@farm.js/webhook",
  "version": "0.1.0",
  "description": "Receive signed Farm Infra webhook deliveries and send events to a receiver",
  "keywords": [
    "farm.js",
    "webhooks"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/farming-labs/farm.js",
    "directory": "packages/farm-webhook"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./sender": {
      "types": "./dist/sender.d.ts",
      "import": "./dist/sender.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@farm.js/core": "workspace:*",
    "@farm.js/webhooks": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.3.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
