  "devDependencies": {
    "@types/node": "^20.10.5",
    "agents": "0.17.4",
    "tsup": "^8.5.1",
    "typescript": "^5.3.3",
    "vitest": "^3.2.7",
    "wrangler": "4.111.0"
  },
  "peerDependencies": {
    "agents": ">=0.17.4 <1",
    "wrangler": ">=4.111.0 <5"
  },
  "engines": {
    "node": ">=22"
