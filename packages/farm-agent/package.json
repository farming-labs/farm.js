{
  "name": "@farm.js/agent",
  "version": "0.1.0-beta.0",
  "description": "Durable agents for Farm.js, served and built by agent-unit",
  "keywords": [
    "agent-unit",
    "agents",
    "ai-sdk",
    "farmjs",
    "mastra"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/farming-labs/farm.js",
    "directory": "packages/farm-agent"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "agent-unit": "^0.3.0"
  },
  "devDependencies": {
    "@farm.js/core": "workspace:*",
    "@types/node": "^22.20.5",
    "tsup": "^8.5.1",
    "typescript": "^5.3.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "peerDependencies": {
    "@farm.js/core": ">=0.1.48 <0.2.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
