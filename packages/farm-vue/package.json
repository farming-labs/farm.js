{
  "name": "@farm.js/vue",
  "version": "0.1.0-beta.26",
  "description": "Vue renderer for FARMJS applications",
  "keywords": [
    "farmjs",
    "renderer",
    "ssr",
    "vue"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/farming-labs/farm.js",
    "directory": "packages/farm-vue"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.mjs",
      "require": "./dist/server.cjs"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.mjs",
      "require": "./dist/client.cjs"
    },
    "./bindings": {
      "types": "./dist/bindings.d.ts",
      "import": "./dist/bindings.mjs",
      "require": "./dist/bindings.cjs"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.mjs",
      "require": "./dist/vite.cjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/server-renderer": "3.5.41"
  },
  "devDependencies": {
    "@farm.js/core": "workspace:*",
    "@farm.js/renderer-tests": "workspace:*",
    "@types/node": "^20.10.5",
    "jsdom": "^25.0.0",
    "tsup": "^8.3.5",
    "typescript": "^5.3.3",
    "vite": "^5.0.10",
    "vitest": "^1.1.0",
    "vue": "3.5.41"
  },
  "peerDependencies": {
    "@farm.js/core": "workspace:*",
    "vue": "^3.5.41"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
