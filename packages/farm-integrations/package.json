{
  "name": "@farm.js/integrations",
  "version": "0.1.0-beta.6",
  "description": "Compatibility package that re-exports official Farm.js integrations",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/farming-labs/farm.js",
    "directory": "packages/farm-integrations"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./better-auth": {
      "types": "./dist/better-auth/index.d.ts",
      "import": "./dist/better-auth/index.js"
    },
    "./ai": {
      "types": "./dist/ai/index.d.ts",
      "import": "./dist/ai/index.js"
    },
    "./authjs": {
      "types": "./dist/authjs/index.d.ts",
      "import": "./dist/authjs/index.js"
    },
    "./clerk": {
      "types": "./dist/clerk/index.d.ts",
      "import": "./dist/clerk/index.js"
    },
    "./auth0": {
      "types": "./dist/auth0/index.d.ts",
      "import": "./dist/auth0/index.js"
    },
    "./auth0/client": {
      "types": "./dist/auth0/client.d.ts",
      "import": "./dist/auth0/client.js"
    },
    "./jobs": {
      "types": "./dist/jobs/index.d.ts",
      "import": "./dist/jobs/index.js"
    },
    "./email": {
      "types": "./dist/email/index.d.ts",
      "import": "./dist/email/index.js"
    },
    "./email/client": {
      "types": "./dist/email/client.d.ts",
      "import": "./dist/email/client.js"
    },
    "./email/schedule": {
      "types": "./dist/email/schedule.d.ts",
      "import": "./dist/email/schedule.js"
    },
    "./polar": {
      "types": "./dist/polar/index.d.ts",
      "import": "./dist/polar/index.js"
    },
    "./polar/client": {
      "types": "./dist/polar/client.d.ts",
      "import": "./dist/polar/client.js"
    },
    "./autumn": {
      "types": "./dist/autumn/index.d.ts",
      "import": "./dist/autumn/index.js"
    },
    "./autumn/client": {
      "types": "./dist/autumn/client.d.ts",
      "import": "./dist/autumn/client.js"
    },
    "./workos": {
      "types": "./dist/workos/index.d.ts",
      "import": "./dist/workos/index.js"
    },
    "./workos/client": {
      "types": "./dist/workos/client.d.ts",
      "import": "./dist/workos/client.js"
    },
    "./stripe": {
      "types": "./dist/stripe/index.d.ts",
      "import": "./dist/stripe/index.js"
    },
    "./stripe/client": {
      "types": "./dist/stripe/client.d.ts",
      "import": "./dist/stripe/client.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "import": "./dist/utils/index.js"
    },
    "./supabase": {
      "types": "./dist/supabase/index.d.ts",
      "import": "./dist/supabase/index.js"
    },
    "./supabase/client": {
      "types": "./dist/supabase/client.d.ts",
      "import": "./dist/supabase/client.js"
    },
    "./unkey": {
      "types": "./dist/unkey/index.d.ts",
      "import": "./dist/unkey/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc",
    "dev": "tsc --watch",
    "type-check": "tsc --noEmit",
    "test": "echo 'No tests in this package'"
  },
  "dependencies": {
    "@farm.js/ai": "workspace:*",
    "@farm.js/auth0": "workspace:*",
    "@farm.js/authjs": "workspace:*",
    "@farm.js/autumn": "workspace:*",
    "@farm.js/better-auth": "workspace:*",
    "@farm.js/clerk": "workspace:*",
    "@farm.js/core": "workspace:*",
    "@farm.js/email": "workspace:*",
    "@farm.js/integration-utils": "workspace:*",
    "@farm.js/jobs": "workspace:*",
    "@farm.js/polar": "workspace:*",
    "@farm.js/stripe": "workspace:*",
    "@farm.js/supabase": "workspace:*",
    "@farm.js/unkey": "workspace:*",
    "@farm.js/workos": "workspace:*"
  }
}
