  "devDependencies": {
    "@clerk/backend": "^3.2.0",
    "@types/react": "^19.0.0",
    "typescript": "^5.3.3"
  },
  "peerDependencies": {
    "@clerk/backend": "^3.2.0",
    "@clerk/react": "^6.1.0",
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  }
