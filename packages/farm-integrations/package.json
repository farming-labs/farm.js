{
  "name": "@farmjs/integrations",
  "version": "0.0.1",
  "description": "Official integration adapters for Farm.js",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./better-auth": {
      "types": "./dist/better-auth/index.d.ts",
      "import": "./dist/better-auth/index.js"
    },
    "./authjs": {
      "types": "./dist/authjs/index.d.ts",
      "import": "./dist/authjs/index.js"
    },
    "./clerk": {
      "types": "./dist/clerk/index.d.ts",
      "import": "./dist/clerk/index.js"
    },
    "./auth0": {
      "types": "./dist/auth0/index.d.ts",
      "import": "./dist/auth0/index.js"
    },
    "./workos": {
      "types": "./dist/workos/index.d.ts",
      "import": "./dist/workos/index.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "import": "./dist/utils/index.js"
    },
    "./supabase": {
      "types": "./dist/supabase/index.d.ts",
      "import": "./dist/supabase/index.js"
    },
    "./supabase/client": {
      "types": "./dist/supabase/client.d.ts",
      "import": "./dist/supabase/client.js"
    }
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc",
    "dev": "tsc --watch",
    "type-check": "tsc --noEmit",
    "test": "echo 'No tests in this package'"
  },
  "dependencies": {
    "@farmjs/core": "workspace:*",
    "@supabase/ssr": "^0.9.0",
    "@supabase/supabase-js": "^2.99.2",
    "@workos-inc/node": "^8.9.0"
  },
  "devDependencies": {
    "@clerk/backend": "^3.2.0",
    "@types/react": "^19.0.0",
    "typescript": "^5.3.3"
  },
  "peerDependencies": {
    "@clerk/backend": "^3.2.0",
    "@clerk/react": "^6.1.0",
    "react": "^18.2.0 || ^19.0.0"
  }
}
