    "@supabase/supabase-js": "^2.99.2",
    "@workos-inc/node": "^8.9.0",
    "ai": "^7.0.11",
    "autumn-js": "^1.2.7",
    "resend": "6.10.0",
    "standardwebhooks": "^1.0.0",
    "stripe": "^20.4.1"
