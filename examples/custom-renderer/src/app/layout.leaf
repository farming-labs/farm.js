<script module>
  // Hydrates, so it keeps its state across client navigation: leaf patches the page below it.
  export const hydrate = true;
  export const metadata = {
    title: "leaf on Farm",
    description: "A custom renderer: leaf renders every route, and Farm does the rest.",
  };
</script>

<script>
  import { Link } from "farm-leaf/bindings";
  import { useEffect, useState } from "leaf";

  const [visits, setVisits] = useState(0);
  // Effects run once leaf has hydrated the root; the e2e tests wait for this attribute.
  const [hydrated, setHydrated] = useState(false);
  useEffect(() => setHydrated(true), []);
</script>

<div class="shell" data-hydrated="{{ hydrated ? 'true' : undefined }}">
  <header>
    <nav aria-label="Pages">
      <Link href="/">Home</Link>
      <Link href="/about">About</Link>
      <Link href="/crops/wheat">Wheat</Link>
      <Link href="/notes">Notes</Link>
      <Link href="/streaming">Streaming</Link>
    </nav>
    <button type="button" id="layout-counter" @click="setVisits((n) => n + 1)">
      Layout clicks: {{ visits }}
    </button>
  </header>
  <main>{{ props.children }}</main>
</div>
