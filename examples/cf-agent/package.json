{
  "name": "farm-example-cf-agent",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "farm dev",
    "build": "farm build",
    "smoke": "node scripts/smoke.mjs",
    "smoke:worker": "node scripts/worker-smoke.mjs",
    "type-check": "tsc --noEmit",
    "verify:worker": "wrangler deploy --dry-run --config .farm-cf-agent.wrangler.jsonc --outdir .farm/cf-agent/wrangler"
  },
  "dependencies": {
    "@farm.js/cf-agent": "workspace:*",
    "@farm.js/core": "workspace:*",
    "agents": "0.17.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260710.1",
    "@farm.js/cli": "workspace:*",
    "@types/node": "^20.10.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.3.3",
    "vite": "^8.0.0",
    "wrangler": "4.111.0"
  }
}
