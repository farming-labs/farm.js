{
  "name": "farm-example-mobile-shell",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "farm dev",
    "build": "farm build --preset node-server",
    "start": "farm start --port 3001 --host 127.0.0.1",
    "mobile:routes": "node scripts/generate-routes.mjs",
    "android:build": "node scripts/generate-routes.mjs && cd android && ./gradlew assembleDebug",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@farm.js/core": "workspace:*",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@farm.js/cli": "workspace:*",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.5.3",
    "vite": "8.3.4"
  }
}
