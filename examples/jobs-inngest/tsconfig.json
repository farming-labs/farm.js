{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "strict": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@farm.js/core": [
        "../../packages/farm/dist/index.d.ts"
      ],
      "@farm.js/core/client": [
        "../../packages/farm/types/client.d.ts"
      ],
      "@farm.js/jobs": [
        "../../packages/farm-jobs/dist/index.d.ts"
      ],
      "@farm.js/jobs/*": [
        "../../packages/farm-jobs/dist/*"
      ]
    },
    "allowImportingTsExtensions": true,
    "types": [
      "node"
    ],
    "skipLibCheck": true
  },
  "include": [
    "src",
    "farm.config.ts"
  ]
}
