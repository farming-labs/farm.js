  },
  "devDependencies": {
    "@farm.js/cli": "workspace:*",
    "@farm.js/mobile": "workspace:*",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.3.3",
    "vite": "8.3.4"
  }
}
