{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install --filter farm-preview-gateway-vercel... --frozen-lockfile",
  "outputDirectory": "public",
  "regions": ["iad1"],
  "functions": {
    "api/index.ts": {
      "maxDuration": 1800
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/api/index.ts"
    }
  ]
}
