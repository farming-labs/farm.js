{
  "name": "farm-rsc-demo",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": { "node": "22.x" },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/nitro-post.mjs && node scripts/vercel-output.mjs",
    "build:vercel": "vite build && node scripts/nitro-post.mjs && node scripts/vercel-output.mjs",
    "build:cloudflare": "NITRO_PRESET=cloudflare_pages vite build",
    "type-check": "tsc --noEmit",
    "preview": "node .output/server/index.mjs",
    "preview:cloudflare": "pnpm run build:cloudflare && npx wrangler pages dev .output/public --compatibility-date=2024-12-01",
    "deploy:vercel": "pnpm run build:vercel && vercel deploy --yes --prebuilt",
    "deploy:vercel:prod": "pnpm run build && vercel deploy --yes --prebuilt --prod",
    "deploy:cloudflare": "pnpm run build:cloudflare && npx wrangler pages deploy .output/public --project-name=farm-rsc-demo"
  },
  "dependencies": {
    "@farm.js/core": "0.1.0-beta.2",
    "picocolors": "^1.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-server-dom-webpack": "19.2.8",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@farm.js/plugin": "0.1.0-beta.2",
    "@rollup/plugin-terser": "^0.4.4",
    "@tailwindcss/vite": "^4.1.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitejs/plugin-rsc": "0.5.32",
    "rsc-html-stream": "^0.0.4",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.5.3",
    "vite": "^6.0.0"
  }
}
