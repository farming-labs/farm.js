{
  "name": "farm.js",
  "version": "0.0.6",
  "description": "A modern React meta-framework that human and ai could understand",
  "workspaces": [
    "packages/*",
    "examples/*",
    "docs",
    "playground"
  ],
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "test": "turbo test",
    "lint": "oxlint . && oxfmt --check .",
    "format": "oxlint --fix . && oxfmt .",
    "lint:fix": "oxlint --fix . && oxfmt .",
    "format:check": "biome format .",
    "type-check": "turbo type-check",
    "clean": "turbo clean",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo --filter \"./packages/*\" build && bumpp && pnpm -r publish --access public --no-git-checks",
    "release:no-build": "bumpp && pnpm -r publish --access public --no-git-checks --tag next",
    "release:canary": "turbo --filter \"./packages/*\" build && bumpp && pnpm -r publish --access public --tag canary --no-git-checks",
    "release:beta": "turbo --filter \"./packages/*\" build && bumpp && pnpm -r publish --access public --tag beta --no-git-checks",
    "bump": "bumpp"
  },
  "dependencies": {
    "@rollup/plugin-terser": "^0.4.4",
    "bumpp": "^10.3.1",
    "h3": "2.0.1-rc.5",
    "nitro": "3.0.0",
    "oxfmt": "^0.27.0",
    "oxlint": "^1.42.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.4.1",
    "@changesets/cli": "^2.27.1",
    "@types/node": "^20.10.5",
    "turbo": "^1.11.2",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.12.1"
}
